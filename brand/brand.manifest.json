    "globalStyles": "src/index.css"
  },
  "identity": {
    "name": "Olivier Trevis",
    "tagline": "Agir et Construire Ensemble"
  },
  "palette": {
    "copper": "#D47A2C",
    "gold": "#F0C982",
    "blue": "#1E6FA5",
    "night": "#040810",
    "white": "#FFFFFF"
  },
  "typography": {
    "ui": "Montserrat",
    "premium": "Cinzel",
    "body": "Inter, sans-serif"
