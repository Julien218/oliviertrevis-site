  "assets": {
    "primaryLogo": {
      "runtimeConstant": "LOGO_OT",
      "localReference": "incoming_files/892f73e5f_LogoOlivierTrevisOfficielJs-INNOVIA.jpg"
    }
  },
  "nonCanonicalPortfolioAssets": [
    "LOGO_MISS",
    "LOGO_FASHION",
    "LOGO_TDD",
    "LOGO_PV",
    "LOGO_SYNERGIE",
    "LOGO_PIXELIUM",
